{
	"compilerOptions": {
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"target": "es2016",
		"module": "commonjs",
		"outDir": "dist",
		"rootDir": "./src",
		"sourceMap": true,
		"declaration": true,
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src"]
}
